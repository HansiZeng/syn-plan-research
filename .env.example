# =============================================================================
# Syn-Plan-Research Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
# =============================================================================

# ======================== Path Configuration ========================

# Data storage root: datasets, checkpoints, caches, eval outputs go here.
# This can be a separate high-capacity filesystem from your code directory.
DATA_ROOT="/gypsum/work1/zamani/hzeng/syn-plan-research"

# ======================== API Keys ========================

# Serper API Key (required for web search during RL training and evaluation)
# Get your key at: https://serper.dev/
SERPER_API_KEY="your_serper_api_key_here"

